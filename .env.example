# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_NAME="Figment"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_SECRET=""                 # long random text. Make one with: openssl rand -base64 48
ADMIN_EMAILS=""                # your email. You approve videos and send payouts.

# --- Rules you can change ---
FREE_VIDEO_LIMIT="3"           # free videos before the paywall
PLATFORM_FEE_BPS="2000"        # your service fee. 2000 = 20%
CREATOR_LICENSE_VERSION="draft-2026-11-14"

# --- Database (Neon) ---
DATABASE_URL=""

# --- Stripe ---
STRIPE_SECRET_KEY=""           # use a TEST key (sk_test_...) until launch
STRIPE_WEBHOOK_SECRET=""           # signing secret of the "Your account" webhook destination
STRIPE_CONNECT_WEBHOOK_SECRET=""   # signing secret of the "Connected accounts" destination (account.updated)
STRIPE_PRICE_WEEKLY=""         # price id of the weekly plan (price_...)
STRIPE_PRICE_MONTHLY=""        # price id of the monthly plan (price_...)

# --- Mux (video) ---
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""     # base64 private key from Mux "Signing keys"

# --- Email (Resend). Leave blank in local dev: sign-in links print in the terminal. ---
RESEND_API_KEY=""
EMAIL_FROM=""
